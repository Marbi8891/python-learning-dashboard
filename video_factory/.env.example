# Copia este archivo a video_factory/.env (no se sube al repositorio). No hay claves: todo es local.

# Carpeta de trabajo para audio, clips y vídeos. Puede estar fuera del repositorio o en un disco externo.
# PLD_VIDEO_WORK_DIR=~/Movies/pld-video-production

# Carpeta desde la que se sirven los vídeos publicados.
# PLD_VIDEO_PUBLISH_DIR=frontend/videos

# Motor de voz: kokoro (local, por defecto), command (cualquier programa) o silent (pruebas).
PLD_TTS_ENGINE=kokoro
PLD_TTS_VOICE_ES=ef_dora
PLD_TTS_VOICE_EN=af_heart
PLD_TTS_SPEED=1.0
# PLD_TTS_MODELS_DIR=~/.cache/pld-video-factory/models

# Solo con PLD_TTS_ENGINE=command. Huecos: {out} {voice} {language} {text_file}
# PLD_TTS_COMMAND=say -v {voice} -o {out} --data-format=LEI16@24000 -f {text_file}

# Renderizador: manim (por defecto) o placeholder (clips lisos, solo para probar el pipeline).
PLD_RENDERER=manim
PLD_FONT_SANS=Helvetica Neue
PLD_FONT_MONO=Menlo

# Música de fondo: desactivada si está vacío. Usa solo música propia o con licencia que lo permita.
PLD_MUSIC_FILE=
PLD_MUSIC_VOLUME_DB=-26
