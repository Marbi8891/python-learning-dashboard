{
  "name": "python-learning-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Tests del frontend del Python Learning Dashboard: unitarios (node --test), end-to-end y entorno QA",
  "scripts": {
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:frontend": "node --experimental-vm-modules --disable-warning=ExperimentalWarning --test \"tests/frontend/*.test.mjs\"",
    "test:frontend:browser": "playwright test -c tests/frontend",
    "qa:static": "node --experimental-vm-modules --disable-warning=ExperimentalWarning scripts/qa/frontend_static.mjs",
    "lint:html": "html-validate \"frontend/*.html\"",
    "lint:css": "stylelint \"frontend/css/*.css\"",
    "qa": "bash scripts/qa/pre-push-check.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.63.0",
    "html-validate": "11.17.0",
    "stylelint": "17.16.0"
  }
}
