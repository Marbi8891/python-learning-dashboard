# Copia a .env y define estos valores localmente. Nunca subas .env al repositorio.
POSTGRES_USER=pld
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA_POR_UNA_LARGA_Y_UNICA
POSTGRES_DB=pld
# URL completa para Compose; codifica caracteres especiales de la contraseña como URL-encoding.
DATABASE_URL=postgresql+psycopg://pld:CAMBIA_ESTA_CONTRASENA_POR_UNA_LARGA_Y_UNICA@db:5432/pld
JWT_SECRET=GENERA_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
