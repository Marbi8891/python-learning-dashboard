# Copia este archivo como .env y ajusta los valores. .env NO se sube a Git.

# SQLite en local. En producción: postgresql+psycopg://usuario:clave@host:5432/db
DATABASE_URL=sqlite:///./dev.db

# OBLIGATORIO. Mínimo 32 caracteres. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Duración de la sesión (minutos) e intentos de login/registro por minuto e IP
ACCESS_TOKEN_MINUTES=60
AUTH_RATE_LIMIT_PER_MINUTE=5

# Orígenes que pueden llamar a la API (formato JSON)
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","https://marbi8891.github.io"]

# Opcional: ruta al contenido (por defecto ../frontend/data/lessons.json)
# LESSONS_FILE=../frontend/data/lessons.json

# URL pública del frontend (para los enlaces de recuperación de contraseña)
FRONTEND_URL=http://localhost:5500
# Minutos que vale un enlace de recuperación (ver docs/auth.md)
# PASSWORD_RESET_MINUTES=30

# Emails de recuperación por la API HTTPS de Brevo (obligatorio en Render gratis, que bloquea SMTP).
# SMTP_FROM debe ser un remitente verificado en Brevo.
# BREVO_API_KEY=

# SMTP para enviar los emails de recuperación. Sin SMTP_HOST no se envían.
# Puerto 587 (STARTTLS) o 465 (TLS directo). Prueba: python -m app.mailer tu@email.com
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Python Learning Dashboard <no-reply@tu-dominio.com>

# Agentes A2A (docs/a2a.md). Desactivados por defecto.
# Proveedor del modelo: ollama (local y gratuito, el predeterminado), anthropic (de pago, solo si
# se elige) o mock. A2A_MOCK_MODEL=true (tests, sin modelo) gana a A2A_MODEL_PROVIDER.
# Con Ollama: instálalo y descarga el modelo a mano (ollama pull qwen2.5-coder:7b).
# Anthropic necesita una API key: es un SECRETO y va solo en tu entorno o en el gestor de
# secretos, nunca en este archivo (ver docs/a2a.md).
# A2A_ENABLED=false
# A2A_MODEL_PROVIDER=ollama
# A2A_OLLAMA_BASE_URL=http://127.0.0.1:11434
# A2A_MODEL=qwen2.5-coder:7b
# A2A_MOCK_MODEL=false
# A2A_MAX_OUTPUT_TOKENS=4096
# A2A_MODEL_TIMEOUT_SECONDS=120
# A2A_BASE_URL=http://127.0.0.1:8000
# A2A_RATE_LIMIT_PER_MINUTE=20
# A2A_DAILY_LIMIT_PER_USER=100
# A2A_GLOBAL_LIMIT_PER_MINUTE=60
